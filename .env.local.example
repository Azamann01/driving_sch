# Copy this file to .env.local for local development, and add the same
# values in Vercel under Project Settings > Environment Variables
# before deploying.

# From your Supabase project settings page (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service_role secret key, also from Project Settings > API. This
# bypasses row level security, it is only ever read server side by the
# Stripe webhook (see app/api/stripe/webhook/route.ts), never sent to
# the browser. Do not reuse the anon key here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From the Stripe dashboard, Developers > API keys. Use a test mode key
# (sk_test_...) until you are ready to take real payments.
STRIPE_SECRET_KEY=your-stripe-secret-key

# From the Stripe dashboard, Developers > Webhooks, after you add an
# endpoint pointing at /api/stripe/webhook. For local development, run
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` with the
# Stripe CLI instead, which prints a webhook secret for you to use here.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# The base URL Stripe should redirect back to after checkout. Use your
# real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From resend.com, API Keys. Confirmation emails are skipped (with a warning
# in the server log) if this is not set, they never block an enquiry or a
# booking from being saved.
RESEND_API_KEY=your-resend-api-key

# Until you verify a sending domain in Resend, leave this unset: it falls back
# to onboarding@resend.dev, which can only deliver to the address that owns
# your Resend account. Once a domain is verified, set this to an address on
# it, e.g. bookings@yourschool.co.uk.
# EMAIL_FROM=bookings@yourdomain.co.uk

# From the Twilio console. Reminder texts are sent by hand from the lessons
# page, and the dashboard tells you if these are missing rather than failing
# silently. TWILIO_FROM_NUMBER is the number you bought, in E.164, e.g.
# +447700900000.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+44your-twilio-number

# The dashboard opens WITHOUT a login by default, so this can be shown to
# people without handing out credentials. That means everything in the
# database is public, which is fine while the data is fictional (seed it with
# `node scripts/seed-demo.mjs`).
#
# Set this to "true" before a real school uses it with real learners on it,
# and the email and password sign in comes back.
# REQUIRE_LOGIN=true
